// Cloudflare settings for Unlock The Count.
// Cloudflare deploys from GitHub on every change to main. Other branches get their own
// preview address (the staging site). By hand: npx wrangler deploy
{
  "name": "unlockthecount",
  "compatibility_date": "2026-11-10",
  "assets": {
    // Everything inside public/ goes live. tools/, engine/ and this file stay private.
    "directory": "./public",
    // /polls/ serves public/polls/index.html
    "html_handling": "auto-trailing-slash",
    // Unknown addresses show public/404.html
    "not_found_handling": "404-page"
  }
}
