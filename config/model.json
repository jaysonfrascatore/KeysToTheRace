    "simulations": 11111,
    "seed": 535,
    "pointScale": 1.5,
    "_weights": "Each signal has a reading from -1 (no) to +1 (yes). Points = weight x reading. Their latest statement stands (a public switch replaces what came before); other signals of the same kind are averaged. A recorded vote on the bill itself locks the member.",
    "weights": {
      "statement": 2.0,
      "priorVote": 1.0,
      "leadership": 0.5,
      "policy": 0.5
    },
    "categories": {
      "yes": 0.85,
      "leanYes": 0.6,
      "leanNo": 0.4,
      "no": 0.15
    },
